*.db filter=lfs diff=lfs merge=lfs -text

# Alle Textdateien mit LF (Linux/Mac kompatibel)
* text=auto eol=lf

# Shell-Skripte immer LF (kritisch für bash auf Linux-Server)
*.sh text eol=lf

# Python & Config
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Modelle (joblib) binaer -- keine Zeilenende-Umwandlung
*.joblib binary
